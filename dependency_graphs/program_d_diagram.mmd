graph TD
    %% VELYNX Program D — Dependency Graph
    %% Layers: Core Engine -> Backend -> Subsystems -> Validation -> Research

    %% ===== CORE ENGINE LAYER =====
    subgraph core["Core Engine (velynx_core/)"]
        vx[velynx.py]
        br[brain.py]
        mm[memory.py]
        lr[learner.py]
        sc[self_coder.py]
    end

    vx --> mm
    vx --> br
    vx --> lr
    vx --> sc
    br --> mm
    lr --> mm
    sc --> mm

    %% ===== BACKEND LAYER =====
    subgraph backend_pkg["Backend Layer"]
        orchestrator[orchestrator.py]
        brain2[brain.py]
        chat[chat.py]
        cli[cli.py]
        cli_ui[cli_ui.py]
        selfcoder2[self_coder.py]
        wipe_db[wipe_db.py]
        diagnose_db[diagnose_db.py]
    end

    %% ===== COGNITION SUBSYSTEM =====
    subgraph cognition["Cognition Subsystem"]
        metacog[metacog.py]
        scenario[scenario_engine.py]
        unified[unified_pipeline.py]
        reasoning[reasoning_engine.py]
        predictive[predictive_core.py]
        decision[decision_policy.py]
        advanced[advanced_cognition.py]
        selfmodel[self_model.py]
    end

    %% ===== MEMORY SUBSYSTEM =====
    subgraph memory["Memory Subsystem"]
        kg[knowledge_graph.py]
        vs[vector_store.py]
        concept_eng[concept_engine.py]
        mem_graph[memory_graph.py]
        episodic[episodic_memory.py]
        session[session.py]
        sqlite[_sqlite.py]
    end

    %% ===== KNOWLEDGE SUBSYSTEM =====
    subgraph knowledge["Knowledge Subsystem"]
        keng[knowledge_engine.py]
        kgraph[knowledge_graph.py]
        voice[voice_engine.py]
        predicate[predicate_resolver.py]
        bridge[bridge.py]
        consolidator[consolidator.py]
    end

    %% ===== AGENCY SUBSYSTEM =====
    subgraph agency["Agency Subsystem"]
