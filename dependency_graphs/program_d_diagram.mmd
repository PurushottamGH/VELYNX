    %% Unified pipeline dependencies
    unified --> advanced
    unified --> concept_eng
    unified --> kgraph
    unified --> unified_ret
    unified --> cont_learn

    %% Reasoning engine
    reasoning --> predicate

    %% Self model
    selfmodel --> kgraph
    selfmodel --> curiosity

    %% Predictive core
    predictive --> sqlite

    %% Root scripts
    cogcore --> coghealth
    cogcore --> cbirth
    cogcore --> lce
    coghealth --> vmetrics
    coghealth --> vreport
    nite --> unified_ret
    teach_script --> codewriter
    bench --> vartifact
    bench --> vdatasets
    bench --> vmetrics
    bench --> vmonitor
    bench --> vregression
    bench --> vrunner
    bench --> decision

    %% Validation deps
    vmetrics --> vinterfaces
    vreport --> vmetrics
    vrunner --> vinterfaces
    vdatasets --> vinterfaces
    vmonitor --> vinterfaces
    vregression --> vinterfaces
    vartifact --> vregression

    %% ===== DUPLICATE MODULES =====
    %% Two knowledge_graph.py files
    mem_kg[memory/knowledge_graph.py]
    know_kg[knowledge/knowledge_graph.py]
    mem_kg -.->|"DUPLICATE"| know_kg

    %% Two brain.py files
    core_br[velynx_core/brain.py]
    be_br[backend/brain.py]
    core_br -.->|"DUPLICATE"| be_br

    %% Two self_coder.py files
    core_sc[velynx_core/self_coder.py]
    be_sc[backend/self_coder.py]
    core_sc -.->|"DUPLICATE"| be_sc
