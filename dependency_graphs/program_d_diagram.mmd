    %% Backend orchestrator dependencies
    orchestrator --> keng
    orchestrator --> metacog
    orchestrator --> voice
    orchestrator --> mem_graph
    orchestrator --> bridge_ag
    orchestrator --> codewriter
    orchestrator --> qa
    orchestrator --> autofix
    orchestrator --> health

