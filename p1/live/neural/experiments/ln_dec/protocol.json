      "script": "outputs/dec_repair1_sesoi_calibration.py",
      "seeds": "100-119"
    },
    "seed_partition": {
      "0-4": "design and diagnostics - BURNED, never decisive",
      "100-119": "SESOI calibration - consumed by the null run above",
      "200-209": "decisive - untouched by every run to date"
    },
    "status": "CLOSED",
    "structural_floor": {
      "argument": "B6 has a provable floor of log(3) on pair_holdout: closure is vacuous on an unseen marker run, so at most three of six body symbols are excludable.  The smallest discrete competence step above that comparator is excluding one more symbol, i.e. moving from three live candidates to two.  Below this the claim would not correspond to any additional structure recovered.",
      "expression": "log(3) - log(2)",
      "value": 0.4054651081081645
    },
    "unit": "nats of mean NLL on the decisive family, comparator minus candidate, per seed",
    "value": 0.4054651081081645
  },
