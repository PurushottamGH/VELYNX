    "template": "def merge_sorted(l1, l2):\n    pass",
    "test_cases": [
      {"input": "merge_sorted([1,2,4], [1,3,4])", "output": "[1, 1, 2, 3, 4, 4]"},
      {"input": "merge_sorted([], [])", "output": "[]"},
      {"input": "merge_sorted([], [0])", "output": "[0]"}
    ],
    "solution": "def merge_sorted(l1, l2):\n    result = []\n    i = j = 0\n    while i < len(l1) and j < len(l2):\n        if l1[i] <= l2[j]:\n            result.append(l1[i]); i += 1\n        else:\n            result.append(l2[j]); j += 1\n    return result + l1[i:] + l2[j:]",
    "techniques": ["two-pointer", "merge"],
    "related_topics": ["linked-lists", "sorting"]
