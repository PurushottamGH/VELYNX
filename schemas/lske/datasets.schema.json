{
  "$defs": {
    "collection": {
      "properties": {
        "confidence": {
          "type": "null"
        },
        "content_digest": {
          "$ref": "record.schema.json#/$defs/hex64"
        },
        "generator": {
          "oneOf": [
            {
              "$ref": "#/$defs/generator"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "pattern": "^DSET-[0-9]{4}-[0-9]{4}$",
          "type": "string"
        },
        "immutability": {
          "properties": {
            "append_only": {
              "const": false
            }
          },
          "type": "object"
        },
        "leakage_audit": {
          "$ref": "#/$defs/leakage_audit"
        },
        "legacy_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lifecycle": {
          "properties": {
            "status": {
              "enum": [
                "Candidate",
                "Active",
                "Dormant",
                "Tombstoned",
                "Deleted"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "primitive": {
          "const": "Environment"
        },
        "provenance": {
          "properties": {
            "kind": {
              "enum": [
                "human_assertion",
                "run_derived",
                "document_derived",
                "external_literature"
              ]
            }
          },
          "type": "object"
        },
        "provenance_reliability": {
          "enum": [
            "reconstructable",
            "archived",
            "legacy_uncertain",
            "unrecoverable"
          ],
          "type": "string"
        },
        "splits": {
          "$ref": "#/$defs/splits"
        },
        "type": {
          "const": "dataset"
        }
      },
      "required": [
        "content_digest",
        "generator",
        "leakage_audit",
        "splits",
        "provenance_reliability"
      ],
      "type": "object"
    },
    "generator": {
      "additionalProperties": false,
      "properties": {
        "code_version": {
          "minLength": 1,
          "type": "string"
        },
        "config_digest": {
          "$ref": "record.schema.json#/$defs/hex64"
        },
        "config_path": {
          "minLength": 1,
          "type": "string"
        },
        "seed": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "seed",
        "config_path",
        "config_digest",
        "code_version"
      ],
      "type": "object"
    },
    "leakage_audit": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "audited": {
                "const": true
              }
            },
            "required": [
              "audited"
            ]
          },
          "then": {
            "properties": {
              "at": {
                "minLength": 1,
                "type": "string"
              },
              "by": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "at": {
          "oneOf": [
            {
              "$ref": "record.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "audited": {
          "type": "boolean"
        },
        "by": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "audited",
        "at",
        "by",
        "findings"
      ],
      "type": "object"
    },
    "split": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "record.schema.json#/$defs/hex64"
        },
        "record_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "record_count"
      ],
      "type": "object"
    },
    "splits": {
      "additionalProperties": {
        "$ref": "#/$defs/split"
      },
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "type": "object"
    }
  },
  "$id": "https://p1.local/schemas/lske/datasets.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "record.schema.json"
    },
    {
      "$ref": "#/$defs/collection"
    }
  ],
  "title": "datasets",
  "type": "object",
  "unevaluatedProperties": false
}
