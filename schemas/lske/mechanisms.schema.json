{
  "$defs": {
    "collection": {
      "properties": {
        "bundled_with": {
          "items": {
            "$ref": "record.schema.json#/$defs/record_id"
          },
          "type": "array"
        },
        "confidence": {
          "type": "object"
        },
        "hypothesis_ids": {
          "items": {
            "$ref": "record.schema.json#/$defs/record_id"
          },
          "minItems": 1,
          "type": "array"
        },
        "id": {
          "pattern": "^MEC-[0-9]{4}-[0-9]{4}$",
          "type": "string"
        },
        "identifiability": {
          "enum": [
            "identified",
            "bundled",
            "unidentified"
          ],
          "type": "string"
        },
        "immutability": {
          "properties": {
            "append_only": {
              "const": false
            }
          },
          "type": "object"
        },
        "legacy_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lifecycle": {
          "properties": {
            "status": {
              "enum": [
                "Candidate",
                "Active",
                "Dormant",
                "Tombstoned",
                "Deleted"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "operability": {
          "enum": [
            "demonstrated",
            "undemonstrated",
            "failed"
          ],
          "type": "string"
        },
        "primitive": {
          "const": "Claim"
        },
        "provenance": {
          "properties": {
            "kind": {
              "enum": [
                "human_assertion",
                "run_derived",
                "document_derived",
                "external_literature"
              ]
            }
          },
          "type": "object"
        },
        "statement": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "mechanism"
        }
      },
      "required": [
        "statement",
        "hypothesis_ids",
        "bundled_with",
        "identifiability",
        "operability"
      ],
      "type": "object"
    }
  },
  "$id": "https://p1.local/schemas/lske/mechanisms.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "record.schema.json"
    },
    {
      "$ref": "#/$defs/collection"
    }
  ],
  "title": "mechanisms",
  "type": "object",
  "unevaluatedProperties": false
}
