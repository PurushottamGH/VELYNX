{
  "$defs": {
    "collection": {
      "properties": {
        "confidence": {
          "type": "null"
        },
        "equivalence_established": {
          "type": "boolean"
        },
        "evidence_ids": {
          "items": {
            "$ref": "record.schema.json#/$defs/record_id"
          },
          "minItems": 1,
          "type": "array"
        },
        "hypothesis_id": {
          "$ref": "record.schema.json#/$defs/record_id"
        },
        "id": {
          "pattern": "^NEG-[0-9]{4}-[0-9]{4}$",
          "type": "string"
        },
        "immutability": {
          "properties": {
            "append_only": {
              "const": true
            }
          },
          "type": "object"
        },
        "legacy_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lifecycle": {
          "properties": {
            "status": {
              "enum": [
                "Candidate",
                "Active",
                "Dormant",
                "Tombstoned",
                "Deleted"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "primitive": {
          "const": "Evidence"
        },
        "provenance": {
          "properties": {
            "kind": {
              "enum": [
                "human_assertion",
                "run_derived",
                "document_derived",
                "external_literature"
              ]
            }
          },
          "type": "object"
        },
        "retry_prohibited": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "record.schema.json#/$defs/scope"
        },
        "statement": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "negative_result"
        }
      },
      "required": [
        "statement",
        "hypothesis_id",
        "scope",
        "equivalence_established",
        "retry_prohibited",
        "evidence_ids"
      ],
      "type": "object"
    }
  },
  "$id": "https://p1.local/schemas/lske/negative_results.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "record.schema.json"
    },
    {
      "$ref": "#/$defs/collection"
    }
  ],
  "title": "negative_results",
  "type": "object",
  "unevaluatedProperties": false
}
