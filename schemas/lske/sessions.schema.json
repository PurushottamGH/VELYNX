{
  "$defs": {
    "annotation": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "record.schema.json#/$defs/timestamp"
        },
        "target_id": {
          "$ref": "record.schema.json#/$defs/record_id"
        },
        "text": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "at",
        "target_id",
        "text"
      ],
      "type": "object"
    },
    "collection": {
      "properties": {
        "actor": {
          "minLength": 1,
          "type": "string"
        },
        "annotations": {
          "items": {
            "$ref": "#/$defs/annotation"
          },
          "type": "array"
        },
        "blinding_state": {
          "enum": [
            "blinded",
            "unblinded",
            "not_applicable"
          ],
          "type": "string"
        },
        "closed": {
          "oneOf": [
            {
              "$ref": "record.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "null"
        },
        "id": {
          "pattern": "^SESS-[0-9]{4}-[0-9]{4}$",
          "type": "string"
        },
        "immutability": {
          "properties": {
            "append_only": {
              "const": true
            }
          },
          "type": "object"
        },
        "legacy_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lifecycle": {
          "properties": {
            "status": {
              "enum": [
                "Candidate",
                "Active",
                "Dormant",
                "Tombstoned",
                "Deleted"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "opened": {
          "$ref": "record.schema.json#/$defs/timestamp"
        },
        "primitive": {
          "const": "Intervention"
        },
        "provenance": {
          "properties": {
            "kind": {
              "enum": [
                "human_assertion",
                "run_derived",
                "document_derived",
                "external_literature"
              ]
            }
          },
          "type": "object"
        },
        "records_touched": {
          "items": {
            "$ref": "record.schema.json#/$defs/record_id"
          },
          "type": "array"
        },
        "type": {
          "const": "research_session"
        }
      },
      "required": [
        "actor",
        "opened",
        "closed",
        "records_touched",
        "annotations",
        "blinding_state"
      ],
      "type": "object"
    }
  },
  "$id": "https://p1.local/schemas/lske/sessions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "record.schema.json"
    },
    {
      "$ref": "#/$defs/collection"
    }
  ],
  "title": "sessions",
  "type": "object",
  "unevaluatedProperties": false
}
