{
  "$defs": {
    "collection": {
      "properties": {
        "assumptions_relied_upon": {
          "items": {
            "oneOf": [
              {
                "pattern": "^ASM-[0-9]{4}-[0-9]{4}$",
                "type": "string"
              },
              {
                "const": "none_declared"
              }
            ]
          },
          "minItems": 1,
          "type": "array"
        },
        "confidence": {
          "type": "null"
        },
        "dimensions": {
          "items": {
            "enum": [
              "existence",
              "measurement_validity",
              "effect_existence",
              "magnitude",
              "mechanism",
              "robustness",
              "generalisation",
              "necessity_over_simpler",
              "resource_efficiency",
              "observability_completeness"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "direction": {
          "enum": [
            "depends-on",
            "indeterminate",
            "invalid",
            "null",
            "opposes",
            "requires-assumption",
            "supports"
          ],
          "type": "string"
        },
        "eligibility": {
          "enum": [
            "exploratory-admissible",
            "confirmatory-admissible",
            "ineligible"
          ],
          "type": "string"
        },
        "id": {
          "pattern": "^EVD-[0-9]{4}-[0-9]{4}$",
          "type": "string"
        },
        "immutability": {
          "properties": {
            "append_only": {
              "const": true
            }
          },
          "type": "object"
        },
        "independence_group": {
          "minLength": 1,
          "type": "string"
        },
        "legacy_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lifecycle": {
          "properties": {
            "status": {
              "enum": [
                "Candidate",
                "Active",
                "Dormant",
                "Tombstoned",
                "Deleted"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "primitive": {
          "const": "Evidence"
        },
        "provenance": {
          "properties": {
            "kind": {
              "enum": [
                "human_assertion",
                "run_derived",
                "document_derived",
                "external_literature"
              ]
            }
          },
          "type": "object"
        },
        "rationale": {
          "minLength": 1,
          "type": "string"
        },
        "run_ids": {
          "items": {
            "$ref": "record.schema.json#/$defs/record_id"
          },
          "minItems": 1,
          "type": "array"
        },
        "source_observation_ids": {
          "items": {
            "$ref": "record.schema.json#/$defs/record_id"
          },
          "minItems": 1,
          "type": "array"
        },
        "target_id": {
          "$ref": "record.schema.json#/$defs/record_id"
        },
        "type": {
          "const": "evidence"
        },
        "unexcluded_alternatives": {
          "items": {
            "$ref": "#/$defs/unexcluded_alternative"
          },
          "type": "array"
        }
      },
      "required": [
        "source_observation_ids",
        "run_ids",
        "target_id",
        "direction",
        "dimensions",
        "eligibility",
        "assumptions_relied_upon",
        "unexcluded_alternatives",
        "rationale",
        "independence_group"
      ],
      "type": "object"
    },
    "unexcluded_alternative": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "minLength": 1,
          "type": "string"
        },
        "why_not_excluded": {
          "type": "string"
        }
      },
      "required": [
        "statement",
        "why_not_excluded"
      ],
      "type": "object"
    }
  },
  "$id": "https://p1.local/schemas/lske/evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "record.schema.json"
    },
    {
      "$ref": "#/$defs/collection"
    }
  ],
  "title": "evidence",
  "type": "object",
  "unevaluatedProperties": false
}
