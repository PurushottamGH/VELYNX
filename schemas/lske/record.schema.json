{
  "$defs": {
    "authority": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "write_target": {
                "enum": [
                  "constitution.amendment",
                  "governance.attestation",
                  "governance.registry",
                  "protocol.freeze",
                  "skb.claim_scope",
                  "skb.claim_status",
                  "skb.decision",
                  "skb.evidence_relation"
                ]
              }
            },
            "required": [
              "write_target"
            ]
          },
          "then": {
            "properties": {
              "is_human": {
                "const": true
              }
            }
          }
        }
      ],
      "properties": {
        "committed_by": {
          "minLength": 1,
          "type": "string"
        },
        "escalated_from": {
          "oneOf": [
            {
              "$ref": "#/$defs/write_target"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_human": {
          "type": "boolean"
        },
        "write_target": {
          "$ref": "#/$defs/write_target"
        }
      },
      "required": [
        "write_target",
        "committed_by",
        "is_human",
        "escalated_from"
      ],
      "type": "object"
    },
    "authority_class": {
      "enum": [
        "OBSERVER",
        "PROPOSER",
        "ENGINEER",
        "SCIENTIST"
      ],
      "type": "string"
    },
    "citation": {
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "doi",
            "arxiv",
            "isbn",
            "url",
            "report"
          ],
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "year": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "identifier",
        "title",
        "year"
      ],
      "type": "object"
    },
    "confidence": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "$ref": "#/$defs/dimensions"
        },
        "level": {
          "oneOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "oneOf": [
            {
              "$ref": "#/$defs/scope"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "level",
        "scope",
        "dimensions"
      ],
      "type": "object"
    },
    "created": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "authority": {
          "$ref": "#/$defs/authority_class"
        },
        "by": {
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/write_target"
        }
      },
      "required": [
        "at",
        "by",
        "authority",
        "target"
      ],
      "type": "object"
    },
    "dimension": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          },
          "if": {
            "properties": {
              "state": {
                "const": "unassessed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "properties": {
        "evidence_ids": {
          "items": {
            "$ref": "#/$defs/record_id"
          },
          "type": "array"
        },
        "state": {
          "enum": [
            "unassessed",
            "assessed_supported",
            "assessed_contested",
            "assessed_failed"
          ],
          "type": "string"
        }
      },
      "required": [
        "state",
        "evidence_ids"
      ],
      "type": "object"
    },
    "dimensions": {
      "additionalProperties": false,
      "properties": {
        "effect_existence": {
          "$ref": "#/$defs/dimension"
        },
        "existence": {
          "$ref": "#/$defs/dimension"
        },
        "generalisation": {
          "$ref": "#/$defs/dimension"
        },
        "magnitude": {
          "$ref": "#/$defs/dimension"
        },
        "measurement_validity": {
          "$ref": "#/$defs/dimension"
        },
        "mechanism": {
          "$ref": "#/$defs/dimension"
        },
        "necessity_over_simpler": {
          "$ref": "#/$defs/dimension"
        },
        "observability_completeness": {
          "$ref": "#/$defs/dimension"
        },
        "resource_efficiency": {
          "$ref": "#/$defs/dimension"
        },
        "robustness": {
          "$ref": "#/$defs/dimension"
        }
      },
      "required": [
        "existence",
        "measurement_validity",
        "effect_existence",
        "magnitude",
        "mechanism",
        "robustness",
        "generalisation",
        "necessity_over_simpler",
        "resource_efficiency",
        "observability_completeness"
      ],
      "type": "object"
    },
    "event_id": {
      "pattern": "^LEV-[0-9a-f]{32}$",
      "type": "string"
    },
    "hex64": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "immutability": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "frozen_at": {
                "type": "null"
              }
            },
            "required": [
              "frozen_at"
            ]
          },
          "then": {
            "properties": {
              "seal": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "frozen_at": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "frozen_at"
            ]
          },
          "then": {
            "properties": {
              "seal": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "append_only": {
          "type": "boolean"
        },
        "frozen_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "seal": {
          "oneOf": [
            {
              "$ref": "#/$defs/hex64"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "append_only",
        "frozen_at",
        "seal"
      ],
      "type": "object"
    },
    "lifecycle": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "CANDIDATE",
            "ACTIVE",
            "DORMANT",
            "TOMBSTONED",
            "DELETED"
          ],
          "type": "string"
        },
        "status": {
          "minLength": 1,
          "type": "string"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/transition"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "state",
        "status",
        "transitions"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "run_derived"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "run_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "document_derived"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "source_paths": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "external_literature"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "citation": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "projection"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "derivation": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "citation": {
          "oneOf": [
            {
              "$ref": "#/$defs/citation"
            },
            {
              "type": "null"
            }
          ]
        },
        "derivation": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "human_assertion",
            "run_derived",
            "document_derived",
            "external_literature",
            "projection"
          ],
          "type": "string"
        },
        "protocol_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/record_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_ids": {
          "items": {
            "$ref": "#/$defs/record_id"
          },
          "type": "array"
        },
        "source_paths": {
          "items": {
            "$ref": "#/$defs/source_path"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "run_ids",
        "protocol_id",
        "source_paths",
        "citation",
        "derivation"
      ],
      "type": "object"
    },
    "record_id": {
      "pattern": "^[A-Z]{3,5}-[0-9]{4}-[0-9]{4}$",
      "type": "string"
    },
    "revision": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "authority": {
          "$ref": "#/$defs/authority_class"
        },
        "by": {
          "minLength": 1,
          "type": "string"
        },
        "change_kind": {
          "enum": [
            "create",
            "amend",
            "annotate",
            "status_transition",
            "supersede",
            "tombstone",
            "restore",
            "delete"
          ],
          "type": "string"
        },
        "prior_content_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/hex64"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "minLength": 1,
          "type": "string"
        },
        "record_version": {
          "minimum": 1,
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/write_target"
        }
      },
      "required": [
        "record_version",
        "at",
        "by",
        "authority",
        "target",
        "change_kind",
        "rationale",
        "prior_content_hash"
      ],
      "type": "object"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "environment_ids": {
          "items": {
            "$ref": "#/$defs/record_id"
          },
          "type": "array"
        },
        "limits": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "population": {
          "minLength": 1,
          "type": "string"
        },
        "regime": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "population",
        "regime",
        "environment_ids",
        "limits"
      ],
      "type": "object"
    },
    "semver": {
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$",
      "type": "string"
    },
    "source_path": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/hex64"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "content_hash"
      ],
      "type": "object"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "transition": {
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "from": {
                  "const": null
                },
                "to": {
                  "const": "CANDIDATE"
                }
              },
              "required": [
                "from",
                "to"
              ]
            },
            {
              "properties": {
                "from": {
                  "const": "CANDIDATE"
                },
                "to": {
                  "const": "ACTIVE"
                }
              },
              "required": [
                "from",
                "to"
              ]
            },
            {
              "properties": {
                "from": {
                  "const": "ACTIVE"
                },
                "to": {
                  "const": "DORMANT"
                }
              },
              "required": [
                "from",
                "to"
              ]
            },
            {
              "properties": {
                "from": {
                  "const": "DORMANT"
                },
                "to": {
                  "const": "ACTIVE"
                }
              },
              "required": [
                "from",
                "to"
              ]
            },
            {
              "properties": {
                "from": {
                  "const": "ACTIVE"
                },
                "to": {
                  "const": "TOMBSTONED"
                }
              },
              "required": [
                "from",
                "to"
              ]
            },
            {
              "properties": {
                "from": {
                  "const": "DORMANT"
                },
                "to": {
                  "const": "TOMBSTONED"
                }
              },
              "required": [
                "from",
                "to"
              ]
            },
            {
              "properties": {
                "from": {
                  "const": "TOMBSTONED"
                },
                "to": {
                  "const": "DELETED"
                }
              },
              "required": [
                "from",
                "to"
              ]
            },
            {
              "properties": {
                "from": {
                  "const": "TOMBSTONED"
                },
                "to": {
                  "const": "ACTIVE"
                }
              },
              "required": [
                "from",
                "to"
              ]
            },
            {
              "properties": {
                "from": {
                  "const": "CANDIDATE"
                },
                "to": {
                  "const": "DELETED"
                }
              },
              "required": [
                "from",
                "to"
              ]
            }
          ]
        }
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "by": {
          "minLength": 1,
          "type": "string"
        },
        "cause": {
          "minLength": 1,
          "type": "string"
        },
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "from": {
          "oneOf": [
            {
              "enum": [
                "CANDIDATE",
                "ACTIVE",
                "DORMANT",
                "TOMBSTONED",
                "DELETED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "enum": [
            "CANDIDATE",
            "ACTIVE",
            "DORMANT",
            "TOMBSTONED",
            "DELETED"
          ],
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "at",
        "by",
        "event_id",
        "cause"
      ],
      "type": "object"
    },
    "write_target": {
      "enum": [
        "constitution.amendment",
        "governance.attestation",
        "governance.registry",
        "projection.render",
        "protocol.draft",
        "protocol.freeze",
        "repo.ci",
        "repo.code",
        "repo.doc",
        "repo.test",
        "skb.claim_scope",
        "skb.claim_status",
        "skb.decision",
        "skb.evidence_relation",
        "skb.observation_draft",
        "work.row"
      ],
      "type": "string"
    }
  },
  "$id": "https://p1.local/schemas/lske/record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "confidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/confidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "content_hash": {
      "$ref": "#/$defs/hex64"
    },
    "created": {
      "$ref": "#/$defs/created"
    },
    "id": {
      "$ref": "#/$defs/record_id"
    },
    "immutability": {
      "$ref": "#/$defs/immutability"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "ontology_version": {
      "$ref": "#/$defs/semver"
    },
    "primitive": {
      "enum": [
        "Run",
        "Environment",
        "Tick",
        "Event",
        "Snapshot",
        "Neuron",
        "Kind",
        "Edge",
        "Graph",
        "DelayLine",
        "EpisodicMemory",
        "Ledger",
        "Policy",
        "Intervention",
        "Protocol",
        "Measurement",
        "Claim",
        "Evidence",
        "Decision"
      ],
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "record_version": {
      "minimum": 1,
      "type": "integer"
    },
    "revisions": {
      "items": {
        "$ref": "#/$defs/revision"
      },
      "type": "array"
    },
    "superseded_by": {
      "oneOf": [
        {
          "$ref": "#/$defs/record_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes": {
      "oneOf": [
        {
          "$ref": "#/$defs/record_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "primitive",
    "title",
    "record_version",
    "ontology_version",
    "content_hash",
    "created",
    "revisions",
    "supersedes",
    "superseded_by",
    "provenance",
    "authority",
    "confidence",
    "lifecycle",
    "immutability"
  ],
  "title": "LSKE universal record envelope",
  "type": "object"
}
