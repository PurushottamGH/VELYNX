<graphml xmlns="http://graphml.graphdrawing.org/xmlns"><key id="type" for_="node" attrname="type" attrtype="string" /><key id="label" for_="node" attrname="label" attrtype="string" /><key id="description" for_="node" attrname="description" attrtype="string" /><key id="edgetype" for_="edge" attrname="edgetype" attrtype="string" /><key id="edgedesc" for_="edge" attrname="description" attrtype="string" /><graph id="ProgramC" edgedefault="directed"><node id="L1"><data key="type">Laws</data><data key="label">HebbianLearning</data><data key="description">Fire together, wire together — coactivation count increments, edge at count&gt;=2, asymptotic weight updates</data></node><node id="L2"><data key="type">Laws</data><data key="label">FreeEnergyProxy</data><data key="description">Cognitive energy E = λ·H + μ·S + ν·A (λ=1.0, μ=2.0, ν=0.5) — stand-in for variational free energy</data></node><node id="L3"><data key="type">Laws</data><data key="label">DirichletMarkovModel</data><data key="description">P(s|c) = (n(c,s)+α)/(N(c)+α·|support|) — additive smoothing with symmetric Dirichlet prior</data></node><node id="L4"><data key="type">Laws</data><data key="label">ShannonSurprise</data><data key="description">I(s) = -log₂ P(s|c) — surprisal in bits, the universal cognitive currency</data></node><node id="L5"><data key="type">Laws</data><data key="label">PrecisionWeightedAttention</data><data key="description">a(s) = 1−P(s|c) ∈ [0,1]; attention = precision of the prediction residual</data></node><node id="L6"><data key="type">Laws</data><data key="label">KLDivergence</data><data key="description">KL(P‖Q) = Σ P(s) log₂(P(s)/Q(s)) — confidence delta per tick</data></node><node id="L7"><data key="type">Laws</data><data key="label">InertiaLaw</data><data key="description">effective_rate = base_rate × (1−stability); mature rules barely move at an anomaly</data></node><node id="L8"><data key="type">Laws</data><data key="label">ExceptionQuarantine</data><data key="description">Contradictions filed as BeliefExceptions inside parent belief, never overwrite the rule</data></node><node id="L9"><data key="type">Laws</data><data key="label">FractureMechanics</data><data key="description">Rule fractures when contradiction_count / support_count ≥ 0.85; dominant exception promoted</data></node><node id="L10"><data key="type">Laws</data><data key="label">StabilityCurve</data><data key="description">stability(n) = ln(1+n) / (ln(1+n)+ln(1+4)) — logarithmic confidence-in-history measure</data></node><node id="L11"><data key="type">Laws</data><data key="label">SynapticPruning</data><data key="description">asymptotic_weight ×= (1.0−decay_rate); edges below prune_threshold deleted</data></node><node id="L12"><data key="type">Laws</data><data key="label">BayesianSurprise</data><data key="description">KL(Beta(1+s,1+f) ‖ Beta(1,1)) — divergence from uniform prior</data></node><node id="L13"><data key="type">Laws</data><data key="label">ExpectedInfoGain</data><data key="description">EIG = H(H)−Eₐ[H(H|A=a)] = I(H;A) for curiosity-driven inquiry</data></node><node id="L14"><data key="type">Laws</data><data key="label">NPMIClustering</data><data key="description">Normalised Pointwise Mutual Information (−1,1) for co-occurrence matrices</data></node><node id="L15"><data key="type">Laws</data><data key="label">SpectralClustering</data><data key="description">Eigengap heuristic + K-Means++ on Laplacian for concept birth</data></node><node id="L16"><data key="type">Laws</data><data key="label">BayesianEdgeEvaluation</data><data key="description">Living edges tracked with Beta posterior: quality, reinforced_count, challenged_count → confidence state</data></node><node id="L17"><data key="type">Laws</data><data key="label">ThermodynamicState</data><data key="description">Scalar parameter controlling strictness vs. exploration in reasoning, from conflict state</data></node><node id="L18"><data key="type">Laws</data><data key="label">ResonancePropagation</data><data key="description">Multi-hop semantic wave propagation: compound resonance = 1−(1−curr)×(1−new_energy)</data></node><node id="L19"><data key="type">Laws</data><data key="label">CognitiveProgressIndex</data><data key="description">CPI = weighted composite of accuracy (0.4), decay (0.3), compression (0.2), resolution (0.1)</data></node><node id="L20"><data key="type">Laws</data><data key="label">FreeEnergyMinimization</data><data key="description">C8 merge policy: accept iff E_after ≤ E_before (ΔE ≥ 0)</data></node><node id="L21"><data key="type">Laws</data><data key="label">ParetoDominance</data><data key="description">C8 merge: reject only if all four vitals (H,S,A,E) worsen simultaneously</data></node><node id="A1"><data key="type">Assumptions</data><data key="label">SymbolAsAtom</data><data key="description">Cognition operates on discrete symbols each with positive probability via Dirichlet smoothing</data></node><node id="A2"><data key="type">Assumptions</data><data key="label">FlatMarkovSufficient</data><data key="description">A single-level Markov chain captures enough predictive structure; hierarchy unnecessary</data></node><node id="A3"><data key="type">Assumptions</data><data key="label">StabilitySolvesForgetting</data><data key="description">Inertia Law + Exception Quarantine prevents catastrophic forgetting without Fisher info</data></node><node id="A4"><data key="type">Assumptions</data><data key="label">SurpriseEqualsDissonance</data><data key="description">Shannon surprisal captures all forms of cognitive dissonance (no valence/signed errors)</data></node><node id="A5"><data key="type">Assumptions</data><data key="label">AttentionIsPrecisionResidual</data><data key="description">Attention = 1−P(obs|context); no biased competition, spatial, or overt/covert attention</data></node><node id="A6"><data key="type">Assumptions</data><data key="label">LocalRulesSufficient</data><data key="description">Rate-based Hebbian coactivation suffices; no STDP, three-factor, or backprop needed</data></node><node id="A7"><data key="type">Assumptions</data><data key="label">FreeEnergyProxyIsAdequate</data><data key="description">E = λH+μS+νA is a sufficient stand-in for variational free energy</data></node><node id="A8"><data key="type">Assumptions</data><data key="label">ConceptBirthWorksFromStats</data><data key="description">Spectral clustering on NPMI-thresholded co-occurrence suffices for concept formation</data></node><node id="A9"><data key="type">Assumptions</data><data key="label">SingleLevelPredictionWorks</data><data key="description">Flat predict/collide/adapt loop is enough; no hierarchical predictive coding needed</data></node><node id="A10"><data key="type">Assumptions</data><data key="label">HandAuthoredScaffoldingOk</data><data key="description">Seeded curriculum and pre-authored ontology acceptable; emergence not required</data></node><node id="A11"><data key="type">Assumptions</data><data key="label">CPIMeasuresLearning</data><data key="description">Four-component CPI (accuracy, decay, compression, resolution) captures genuine becoming</data></node><node id="A12"><data key="type">Assumptions</data><data key="label">ProbationaryTestingWorks</data><data key="description">Probation over N deviation trials with coverage threshold validates latent abstractions</data></node><node id="A13"><data key="type">Assumptions</data><data key="label">MetaphoricalNeuroscienceOk</data><data key="description">Terms like resonance, thermodynamic state, sleep cycle need no literal biological mechanism</data></node><node id="A14"><data key="type">Assumptions</data><data key="label">RateBasedHebbianSufficient</data><data key="description">Rate-based coactivation counts capture Hebbian learning without spike-timing</data></node><node id="A15"><data key="type">Assumptions</data><data key="label">EdgeWeightAsConfidence</data><data key="description">Asymptotic weight + Bayesian state fully capture edge reliability</data></node><node id="A16"><data key="type">Assumptions</data><data key="label">ConjugatePriorsTractable</data><data key="description">Beta and Dirichlet conjugate priors keep Bayesian computations tractable</data></node><node id="V1"><data key="type">Variables</data><data key="label">SurpriseBits</data><data key="description">prediction_error = -log₂ P(obs|context); the universal cognitive signal (bits)</data></node><node id="V2"><data key="type">Variables</data><data key="label">AttentionWeight</data><data key="description">1−P(obs|context) ∈ [0,1]; precision of the residual, drives focus</data></node><node id="V3"><data key="type">Variables</data><data key="label">ConfidenceDelta</data><data key="description">KL(posterior‖prior) in bits; magnitude of belief shift per tick</data></node><node id="V4"><data key="type">Variables</data><data key="label">Stability</data><data key="description">ln(1+n)/(ln(1+n)+ln(5)) → [0,1); resistance to change</data></node><node id="V5"><data key="type">Variables</data><data key="label">FractureRatio</data><data key="description">contradiction_count / support_count; approaches 1.0 when rule is candidate for revision</data></node><node id="V6"><data key="type">Variables</data><data key="label">SupportCount</data><data key="description">Raw episodic tally of confirmations of a rule</data></node><node id="V7"><data key="type">Variables</data><data key="label">ContradictionCount</data><data key="description">Raw episodic tally of anomalies quarantined against a rule</data></node><node id="V8"><data key="type">Variables</data><data key="label">EffectiveLearningRate</data><data key="description">base_rate × (1−stability); Inertia Law governs belief movement</data></node><node id="V9"><data key="type">Variables</data><data key="label">H_Entropy</data><data key="description">Conditional Shannon entropy of cluster-transition Markov chain (bits)</data></node><node id="V10"><data key="type">Variables</data><data key="label">S_SurpriseSpatial</data><data key="description">Euclidean distance between predicted centroid and observed vector</data></node><node id="V11"><data key="type">Variables</data><data key="label">A_ActiveLoad</data><data key="description">Live K-Means clusters + spatial volume of quarantined anomaly cloud</data></node><node id="V12"><data key="type">Variables</data><data key="label">E_CognitiveEnergy</data><data key="description">λH + μS + νA (λ=1.0, μ=2.0, ν=0.5); headline free-energy proxy</data></node><node id="V13"><data key="type">Variables</data><data key="label">PredictionAccuracyTrend</data><data key="description">EWMA of 1−normalized(surprise); ∈ [0,1]; CPI accuracy component</data></node><node id="V14"><data key="type">Variables</data><data key="label">AverageSurpriseDecay</data><data key="description">EWMA of recovery fraction after novelty spike; CPI decay component</data></node><node id="V15"><data key="type">Variables</data><data key="label">ConceptCompressionRatio</data><data key="description">experiences / consolidated concepts; ≥ 1; CPI compression component</data></node><node id="V16"><data key="type">Variables</data><data key="label">ContradictionsResolved</data><data key="description">Monotone counter of reified contradictions; CPI resolution component</data></node><node id="V17"><data key="type">Variables</data><data key="label">ThermodynamicStateValue</data><data key="description">Scalar controlling reasoning strictness vs. exploration (from conflict)</data></node><node id="V18"><data key="type">Variables</data><data key="label">ResonanceScore</data><data key="description">Multi-hop activation propagation value; compound resonance formula</data></node><node id="V19"><data key="type">Variables</data><data key="label">EdgeAsymptoticWeight</data><data key="description">Living edge strength after Hebbian reinforcement; decays over time</data></node><node id="V20"><data key="type">Variables</data><data key="label">ProbationCoverage</data><data key="description">hits / trials for a probationary concept; ≥ 0.60 to confirm</data></node><node id="V21"><data key="type">Variables</data><data key="label">PromisedBits</data><data key="description">Predictive bits a concept birth promises to save (H_before − H_after)</data></node><node id="V22"><data key="type">Variables</data><data key="label">BayesianSurpriseKL</data><data key="description">KL(Beta(1+s,1+f)‖Beta(1,1)); surprise at concept reliability</data></node><node id="V23"><data key="type">Variables</data><data key="label">Regime</data><data key="description">Cognitive state: OPTIMAL / LEARNING / EXHAUSTION</data></node><node id="V24"><data key="type">Variables</data><data key="label">EnergyExhaustionThreshold</data><data key="description">E ≥ 18.0 signals fragmentation and triggers concept birth</data></node><node id="V25"><data key="type">Variables</data><data key="label">NPMIScore</data><data key="description">Normalised Pointwise Mutual Information between features</data></node><node id="E1"><data key="type">Experiments</data><data key="label">C1_PredictiveUnderstanding</data><data key="description">Engine holds a standing prediction; reality collides to produce surprise, driving attention/learning/concept formation</data></node><node id="E2"><data key="type">Experiments</data><data key="label">C2_ExplainPrediction</data><data key="description">Every forecast carries a rationale and localized world model (rule + exceptions)</data></node><node id="E3"><data key="type">Experiments</data><data key="label">C3_PredictionFailureAnalysis</data><data key="description">When surprise breaches threshold, engine authors causal_hypothesis positing missing intermediate cause</data></node><node id="E4"><data key="type">Experiments</data><data key="label">C5_CuriosityEngine</data><data key="description">Curiosity selects inquiry maximizing EIG over structural hypotheses about concept-trait relations</data></node><node id="E5"><data key="type">Experiments</data><data key="label">C6_StableBeliefRevision</data><data key="description">Multidimensional beliefs with Inertia Law, Exception Quarantine, and Fracture mechanics</data></node><node id="E6"><data key="type">Experiments</data><data key="label">C7_SensoriumMonitor</data><data key="description">Continuous loop: world→SensorArray→VectorPredictionCore→FreeEnergy vitals→on EXHAUSTION mine quarantine</data></node><node id="E7"><data key="type">Experiments</data><data key="label">C8_DecisionPolicy</data><data key="description">Staged memory restructuring: ReplayEngine sandbox-simulates merges, DecisionPolicy judges</data></node><node id="E8"><data key="type">Experiments</data><data key="label">SleepCycleExperiment</data><data key="description">run_sleep_cycle(): decay weights, prune edges, delete orphans, run gap scanner</data></node><node id="E9"><data key="type">Experiments</data><data key="label">AttentionModulatorDemo</data><data key="description">Compare cluster assignments with/without attention; same stream, different cluster geometry</data></node><node id="E10"><data key="type">Experiments</data><data key="label">CPILiveFireSimulation</data><data key="description">100-experience simulation with GenerativeWorld + PredictiveAgent + ReflectionEngine</data></node><node id="E11"><data key="type">Experiments</data><data key="label">ProbationaryConceptPipeline</data><data key="description">Candidate birth when EXHAUSTED, watch over PROBATION_MIN_TRIALS, confirm if ≥ 0.60 coverage</data></node><node id="E12"><data key="type">Experiments</data><data key="label">ConceptBirthEngine</data><data key="description">Emergent clustering: NPMI thresholding, spectral eigengap, greedy seed-growth, LatentConcept spawning</data></node><node id="E13"><data key="type">Experiments</data><data key="label">ReplayEngineSandbox</data><data key="description">Clone substrate, apply proposed merge, measure H/S/A, produce DecisionScore</data></node><node id="S1"><data key="type">Stages</data><data key="label">PreC1_DirichletMarkov</data><data key="description">Flat variable-order Markov model with symmetric Dirichlet prior (pre-C6 substrate)</data></node><node id="S2"><data key="type">Stages</data><data key="label">C1_PredictiveLoop</data><data key="description">Continuous predict/collide/adapt loop; engine always holds a standing prediction</data></node><node id="S3"><data key="type">Stages</data><data key="label">C2_ExplainPrediction</data><data key="description">Rationale generation per prediction; localized world model with rule + exceptions</data></node><node id="S4"><data key="type">Stages</data><data key="label">C3_HypothesisGeneration</data><data key="description">Causal hypothesis triggered when surprise exceeds threshold</data></node><node id="S5"><data key="type">Stages</data><data key="label">C5_CuriosityInquiry</data><data key="description">Curiosity engine selects highest-EIG question about concept-trait relationships</data></node><node id="S6"><data key="type">Stages</data><data key="label">C6_StableBelief</data><data key="description">Multidimensional beliefs with stability, quarantine, fracture; replaces flat substrate</data></node><node id="S7"><data key="type">Stages</data><data key="label">C7_SensoriumProcessing</data><data key="description">Continuous vector-based processing; prediction core + latent cause discovery</data></node><node id="S8"><data key="type">Stages</data><data key="label">C8_MergeGovernance</data><data key="description">Replay sandbox simulates memory restructurings; DecisionPolicy accepts/rejects</data></node><node id="S9"><data key="type">Stages</data><data key="label">Stage0_Probation</data><data key="description">Probationary concept as temporary overlay (not committed); watched over deviation trials</data></node><node id="S10"><data key="type">Stages</data><data key="label">SleepCycle</data><data key="description">Synaptic decay, edge pruning, orphan deletion, gap scanning</data></node><node id="S11"><data key="type">Stages</data><data key="label">LivingGraphPhase</data><data key="description">Hebbian coactivation → edge creation → asymptotic weight reinforcement</data></node><node id="S12"><data key="type">Stages</data><data key="label">ResonancePhase</data><data key="description">Multi-hop semantic wave propagation through Bayesian living graph</data></node><node id="S13"><data key="type">Stages</data><data key="label">DreamState</data><data key="description">Subconscious metaphorical linking of charged but unlinked concepts via FAISS</data></node><node id="S14"><data key="type">Stages</data><data key="label">MetacognitivePenalty</data><data key="description">Bayesian penalty on edges that led to rejected/hallucinated responses</data></node><node id="S15"><data key="type">Stages</data><data key="label">OntologyIntegration</data><data key="description">Birth concepts passed into World Model Registry and soul graph for reasoning</data></node><node id="R1"><data key="type">Risks</data><data key="label">FEPProxyNotFEP</data><data key="description">E=λH+μS+νA is NOT variational free energy; no generative likelihood, no posterior approximation; coefficients hand-tuned</data></node><node id="R2"><data key="type">Risks</data><data key="label">NoHierarchicalPredCoding</data><data key="description">Single-level flat Markov; no hierarchy, canonical microcircuit, or multi-level precision weighting</data></node><node id="R3"><data key="type">Risks</data><data key="label">CatastrophicForgettingRisk</data><data key="description">C6 Inertia Law + quarantine may not generalize; fracture mechanic invented, not biologically validated</data></node><node id="R4"><data key="type">Risks</data><data key="label">OverclaimedNeuroscience</data><data key="description">PI review: zero contact with neuroscience; no STDP, neuromodulation, LTP/LTD mechanisms</data></node><node id="R5"><data key="type">Risks</data><data key="label">NothingDevelops</data><data key="description">Scaffolding is hand-authored; nothing develops — PI review core finding</data></node><node id="R6"><data key="type">Risks</data><data key="label">NoSTDP</data><data key="description">Rate-based Hebbian only; no spike-timing dependence, no temporal asymmetry</data></node><node id="R7"><data key="type">Risks</data><data key="label">NoDopamineNeuromodulation</data><data key="description">No reward prediction error, no ACh/NE/5-HT/DA modulation, no three-factor learning</data></node><node id="R8"><data key="type">Risks</data><data key="label">NoHomeostasis</data><data key="description">No synaptic scaling, firing rate homeostasis, E/I balance, or BCM sliding threshold</data></node><node id="R9"><data key="type">Risks</data><data key="label">ActiveInferenceOverclaim</data><data key="description">Only learning-rate modulation implemented; no policy selection, no expected free energy</data></node><node id="R10"><data key="type">Risks</data><data key="label">ThermodynamicMetaphor</data><data key="description">Thermodynamic state has no connection to statistical mechanics; could mislead</data></node><node id="R11"><data key="type">Risks</data><data key="label">CuriosityLimited</data><data key="description">Only structural hypothesis testing; no learning-progress or competence-based exploration</data></node><node id="R12"><data key="type">Risks</data><data key="label">NoSensorimotorGrounding</data><data key="description">Piagetian sensorimotor bootstrapping absent; static embeddings lack sensory grounding</data></node><node id="R13"><data key="type">Risks</data><data key="label">ConstitutionConflicts</data><data key="description">Science (methodology), Uncertainty (honest reporting), Epistemology (traceable sources) at risk</data></node><node id="R14"><data key="type">Risks</data><data key="label">ScaffoldingNotEmergent</data><data key="description">Fixed curriculum with pre-answered questions; no autonomous learning progress</data></node><node id="R15"><data key="type">Risks</data><data key="label">MetaphoricalLanguageMisleads</data><data key="description">Resonance, thermodynamic state, sleep cycle are metaphors, not literal neuroscience</data></node><node id="R16"><data key="type">Risks</data><data key="label">EpisodicMemoryNotNeural</data><data key="description">Episodic memory is a causal event log / SQLite store, not auto-associative network</data></node><node id="R17"><data key="type">Risks</data><data key="label">WorkingMemorySimplistic</data><data key="description">Simple FIFO key-value store; no central executive, phonological loop, visuospatial sketchpad</data></node><node id="M1"><data key="type">Metrics</data><data key="label">CPI_Composite</data><data key="description">Cognitive Progress Index = weighted blend of accuracy (0.4), decay (0.3), compression (0.2), resolution (0.1); ∈ [0,1]</data></node><node id="M2"><data key="type">Metrics</data><data key="label">TransitionEntropy_H</data><data key="description">Conditional Shannon entropy H(next|current) of cluster-transition Markov chain (bits)</data></node><node id="M3"><data key="type">Metrics</data><data key="label">SpatialSurprise_S</data><data key="description">Euclidean distance between predicted centroid and observed vector</data></node><node id="M4"><data key="type">Metrics</data><data key="label">ActiveLoad_A</data><data key="description">Cluster count + anomaly spatial volume</data></node><node id="M5"><data key="type">Metrics</data><data key="label">CognitiveEnergy_E</data><data key="description">λH + μS + νA; headline free-energy proxy; threshold at 18.0 for exhaustion</data></node><node id="M6"><data key="type">Metrics</data><data key="label">PredictionAccuracy</data><data key="description">EWMA of 1−normalized(surprise); ∈ [0,1]; rising = converging on world</data></node><node id="M7"><data key="type">Metrics</data><data key="label">SurpriseDecayRate</data><data key="description">EWMA of recovery fraction after novelty spike; 1 = instant recovery</data></node><node id="M8"><data key="type">Metrics</data><data key="label">CompressionRatio</data><data key="description">experiences / consolidated concepts; higher = more abstraction</data></node><node id="M9"><data key="type">Metrics</data><data key="label">ContradictionsResolvedCount</data><data key="description">Monotone integer; each reified concept increments it</data></node><node id="M10"><data key="type">Metrics</data><data key="label">FractureRatio</data><data key="description">contradiction_count / support_count; ≥ 0.85 triggers fracture</data></node><node id="M11"><data key="type">Metrics</data><data key="label">ProbationCoverage</data><data key="description">hits / trials for probationary concept; must be ≥ 0.60 to confirm</data></node><node id="M12"><data key="type">Metrics</data><data key="label">ExpectedInfoGain</data><data key="description">I(H;A) in bits; curiosity engine uses this to select inquiry</data></node><node id="M13"><data key="type">Metrics</data><data key="label">BayesianSurpriseValue</data><data key="description">KL(Beta(1+s,1+f) ‖ Beta(1,1)); concept reliability surprise</data></node><node id="M14"><data key="type">Metrics</data><data key="label">EdgeConfidence</data><data key="description">Bayesian state: ACTIVE / CONTESTED / INFERRED / UNCERTAIN / VERIFIED</data></node><node id="M15"><data key="type">Metrics</data><data key="label">EdgeAsymptoticWeight</data><data key="description">Living edge strength after decay and reinforcement</data></node><node id="M16"><data key="type">Metrics</data><data key="label">ResonanceFieldScore</data><data key="description">Compound activation score after multi-hop propagation</data></node><node id="M17"><data key="type">Metrics</data><data key="label">BottleneckMeanAccuracy</data><data key="description">Per-concept mean accuracy; chronic if consolidated but &lt; 0.55</data></node><node id="M18"><data key="type">Metrics</data><data key="label">PromisedBitsDelta</data><data key="description">H_before − H_after at concept birth; predictive uncertainty reduction</data></node><node id="M19"><data key="type">Metrics</data><data key="label">SurpriseSlope</data><data key="description">OLS slope of recent average_surprise; |slope|&lt;ε + level&gt;threshold = plateau</data></node><node id="K1"><data key="type">KillCriteria</data><data key="label">CPIDeclining</data><data key="description">CPI consistently drops across runs — learning stagnates or reverses</data></node><node id="K2"><data key="type">KillCriteria</data><data key="label">CatastrophicForgettingPersists</data><data key="description">C6 Inertia Law + quarantine fails to protect mature rules in long-running regimes</data></node><node id="K3"><data key="type">KillCriteria</data><data key="label">ConstitutionViolation</data><data key="description">Science/Uncertainty/Epistemology constitutions breached</data></node><node id="K4"><data key="type">KillCriteria</data><data key="label">NothingDevelopsPersists</data><data key="description">Scaffolding remains entirely hand-authored; PI review verdict never addressed</data></node><node id="K5"><data key="type">KillCriteria</data><data key="label">SurprisePlateauUnresolved</data><data key="description">Average surprise plateaus above stuck_threshold (1.5 bits) with bottleneck &lt; 0.55</data></node><node id="K6"><data key="type">KillCriteria</data><data key="label">ExhaustionSustained</data><data key="description">Cognitive energy E ≥ 18.0 sustained; fragmentation signal without discovery</data></node><node id="K7"><data key="type">KillCriteria</data><data key="label">FractureSupersaturation</data><data key="description">fracture_ratio ≥ 1.0 sustained across multiple contexts; rules cannot stabilize</data></node><node id="K8"><data key="type">KillCriteria</data><data key="label">NoGenuineLearning</data><data key="description">CPI near 0.5 with flat trajectory while surprise stays high</data></node><node id="K9"><data key="type">KillCriteria</data><data key="label">FEPMisrepresentation</data><data key="description">FEP proxy presented as Friston free energy without qualification fails Science constitution</data></node><node id="K10"><data key="type">KillCriteria</data><data key="label">ProbationNeverConfirms</data><data key="description">All probationary candidates rejected; hypothesis testing pipeline fails to find valid structures</data></node><edge id="L1_A14_depends_on" source="L1" target="A14"><data key="edgetype">depends_on</data><data key="edgedesc">Rate-based Hebbian depends on coactivation being sufficient</data></edge><edge id="L2_A7_depends_on" source="L2" target="A7"><data key="edgetype">depends_on</data><data key="edgedesc">Proxy depends on 3-term sum approximating variational free energy</data></edge><edge id="L3_A1_depends_on" source="L3" target="A1"><data key="edgetype">depends_on</data><data key="edgedesc">Dirichlet-Markov depends on symbols as atomic units with positive probability</data></edge><edge id="L4_A4_depends_on" source="L4" target="A4"><data key="edgetype">depends_on</data><data key="edgedesc">Shannon surprisal depends on capturing all cognitive dissonance</data></edge><edge id="L5_A5_depends_on" source="L5" target="A5"><data key="edgetype">depends_on</data><data key="edgedesc">Attention depends on precision-of-residual being sufficient</data></edge><edge id="L7_A3_depends_on" source="L7" target="A3"><data key="edgetype">depends_on</data><data key="edgedesc">Inertia Law depends on stability preventing catastrophe</data></edge><edge id="L8_A3_depends_on" source="L8" target="A3"><data key="edgetype">depends_on</data><data key="edgedesc">Quarantine depends on filing anomalies without rewriting being sufficient</data></edge><edge id="L9_A3_depends_on" source="L9" target="A3"><data key="edgetype">depends_on</data><data key="edgedesc">Fracture depends on promotion-of-dominant-exception strategy</data></edge><edge id="L11_A1_depends_on" source="L11" target="A1"><data key="edgetype">depends_on</data><data key="edgedesc">Pruning depends on weight-threshold model being sufficient</data></edge><edge id="L12_A16_depends_on" source=