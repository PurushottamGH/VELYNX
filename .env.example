# ============================================================
# VELYNX – Environment Configuration
# Fill in your actual values below.  Leave blank to skip
# a provider (Wikipedia / arXiv are always available free).
# ============================================================

# Gitlawb OpenGateway – required for LLM reasoning (Phase 1)
# Get your key at https://opengateway.gitlawb.com
OPENGATEWAY_API_KEY=
OPENGATEWAY_BASE_URL=https://opengateway.gitlawb.com/v1
OPENGATEWAY_MODEL=mimo-v2.5-pro

# Tavily Search – AI-optimised web search (https://tavily.com)
TAVILY_API_KEY=

# Brave Search – ad-free web API (https://brave.com/search/api)
BRAVE_SEARCH_API_KEY=

# Serper.dev – Google-search wrapper (https://serper.dev)
SERPER_API_KEY=

# SearXNG – self-hosted meta-search instance
# Use http://localhost:8080 when running locally via Docker
SEARXNG_BASE_URL=

# Redis – used by session memory (vector store is a stub)
# Leave blank to run without session history
REDIS_URL=

# Memory backend – "chroma" (default) or "json" (fallback)
# ChromaDB requires: pip install chromadb sentence-transformers
VELYNX_MEMORY_BACKEND=chroma

# Set to 1 to skip embedding loading (useful on Windows torch DLL issues)
# VELYNX_SKIP_EMBEDDING=1
