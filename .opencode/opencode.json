{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "velynx-director",

  "plugin": [
    "@zhafron/opencode-kiro-auth",
    "@ai-sdk/openai-compatible"
  ],

  "provider": {
    "kiro": {
      "models": {
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7"
        }
      }
    },

    "openai": {
      "options": {
        "baseURL": "https://zenmux.ai/api/v1",
        "apiKey": "{env:ZENMUX_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2 Free",
          "id": "z-ai/glm-5.2-free"
        }
      }
    },

    "g0i": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.g0i.ai/v1",
        "apiKey": "YOUR_G0I_API_KEY"
      },
      "models": {
        "claude-opus-4-7": {},
        "claude-sonnet-4-6": {},
        "claude-opus-4-8": {},
        "gpt-5.4": {}
      }
    }
  },

  "model": "g0i/claude-opus-4-7"
}