        "mayor": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "Name of the current chief executive or mayor."
        },
        "timezone_name": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {
            "enum": ["UTC-12", "UTC-11", "UTC-10", "UTC-9", "UTC-8", "UTC-7", "UTC-6", "UTC-5", "UTC-4", "UTC-3", "UTC-2", "UTC-1", "UTC+0", "UTC+1", "UTC+2", "UTC+3", "UTC+4", "UTC+5", "UTC+6", "UTC+7", "UTC+8", "UTC+9", "UTC+10", "UTC+11", "UTC+12"]
          },
          "description": "IANA-derived timezone offset."
        }
      }
    },

    "NaturalFeature": {
      "parent": "Location",
      "facets": [],
      "disjoint_with": [],
      "description": "A naturally occurring geographic feature — mountain, river, forest, desert, ocean, or similar.",
      "attributes": {
        "feature_type": {
          "datatype": "str",
          "required": true,
          "default": null,
          "constraints": {
            "enum": ["mountain", "volcano", "river", "lake", "ocean", "sea", "desert", "forest", "glacier", "canyon", "waterfall", "cave", "reef", "island", "peninsula", "plateau", "valley", "wetland", "tundra", "geyser"]
          },
          "description": "Geomorphological classification."
        },
        "geological_era": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {
            "enum": ["precambrian", "paleozoic", "mesozoic", "cenozoic", "quaternary"]
          },
          "description": "Dominant geological era of formation."
        }
      }
    },

    "Concept": {
      "parent": "Entity",
      "facets": [],
      "disjoint_with": ["PhysicalObject", "Organization", "Location"],
      "description": "An abstract idea, notion, or intellectual construct that has no inherent physical form.",
      "attributes": {
        "creator": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "Person or group who originated or formalised the concept."
        },
        "creation_date": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "description": "ISO-8601 date the concept was first articulated (YYYY-MM-DD)."
        },
        "domain": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {
            "enum": ["philosophy", "science", "mathematics", "law", "art", "economics", "politics", "technology", "education", "sociology", "linguistics", "medicine", "engineering", "psychology", "history", "theology", "literature"]
          },
          "description": "Intellectual domain or discipline."
        },
        "status": {
          "datatype": "str",
          "required": false,
          "default": "proposed",
          "constraints": {
            "enum": ["proposed", "accepted", "debated", "superseded", "rejected", "experimental", "canonical", "speculative"]
          },
          "description": "Current standing within the relevant community of practice."
        },
        "confidence": {
          "datatype": "float",
          "required": false,
          "default": null,
          "constraints": { "min": 0, "max": 1 },
          "description": "Subjective belief confidence in the concept's validity (0–1)."
        }
      }
    },

    "Plan": {
      "parent": "Concept",
      "facets": [],
      "disjoint_with": [],
      "description": "A proposed sequence of actions intended to achieve a goal.",
      "attributes": {
        "deadline": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "description": "ISO-8601 target completion date (YYYY-MM-DD)."
        },
        "priority": {
          "datatype": "str",
          "required": false,
          "default": "medium",
          "constraints": {
            "enum": ["critical", "high", "medium", "low", "deferred"]
          },
          "description": "Urgency ranking relative to other plans."
        },
        "completed": {
          "datatype": "bool",
          "required": false,
          "default": false,
          "constraints": {},
          "description": "Whether the plan has been fully executed."
        }
      }
    },

    "Theory": {
      "parent": "Concept",
      "facets": [],
      "disjoint_with": [],
      "description": "A systematically organised body of knowledge or explanatory framework, often empirically tested.",
      "attributes": {
        "falsifiable": {
          "datatype": "bool",
          "required": false,
          "default": true,
          "constraints": {},
          "description": "Whether the theory makes claims that can be empirically disproven."
        },
        "evidence_level": {
          "datatype": "str",
          "required": false,
          "default": "hypothesis",
          "constraints": {
            "enum": ["speculation", "hypothesis", "supported", "well_supported", "consensus", "law", "disproven"]
          },
          "description": "Strength of corroborating evidence."
        },
        "citations": {
          "datatype": "list",
          "required": false,
          "default": [],
          "constraints": {},
          "description": "Key references or works associated with the theory."
        }
      }
    },

    "Agreement": {
      "parent": "Concept",
      "facets": [],
      "disjoint_with": [],
      "description": "A negotiated and typically binding arrangement between two or more parties.",
      "attributes": {
        "parties": {
          "datatype": "list",
          "required": true,
          "default": null,
          "constraints": {},
          "description": "Names of the signatory parties."
        },
        "effective_date": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "description": "ISO-8601 date the agreement took effect (YYYY-MM-DD)."
        },
        "expiration_date": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "description": "ISO-8601 date the agreement expires (YYYY-MM-DD)."
        },
        "legally_binding": {
          "datatype": "bool",
          "required": false,
          "default": true,
          "constraints": {},
          "description": "Whether the agreement is enforceable under law."
        }
      }
    }
  },

  "predicate_map": {
    "_comment": "Surface predicate (as it appears in an extracted triple's relation slot, lowercased) -> canonical schema attribute key. The schema gatekeeper uses this to decide whether a TEACH targets a typed attribute. A predicate present here but whose attribute is NOT on the target entity's resolved schema triggers an UNKNOWN_ATTRIBUTE rejection (e.g. 'has legs' -> leg_count is mapped, but leg_count is not on Vehicle, so 'My Tesla has 5000 legs' is rejected structurally). Predicates absent from this map are treated as free-form and always accepted (open-world).",

