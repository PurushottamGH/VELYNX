{
  "_comment": "VELYNX Phase 62+ — Expanded Foundational Ontology. Extends the Phase 62 core (PhysicalObject, Vehicle, Electronics, Person) with three new structural layers: Organization (companies, agencies, institutions), Location (geographic + built spaces), and Concept (abstract ideas, plans, theories, agreements). Entity is promoted to the new taxonomic root. The predicate_map is expanded with ~80 new NL→attribute mappings covering the full surface. All structural additions maintain compatibility with the Facet system (type-level + instance-level) and the Schema Gatekeeper's four-stage classifier. The software taxonomy (Software/DesktopApplication/ThreeDModelingApp) is still loaded separately by build_3d_software_world() and absorbed at runtime.",
  "version": 2,
  "root": "Entity",
  "types": {
    "Entity": {
      "parent": null,
      "facets": [],
      "disjoint_with": [],
      "description": "The ultimate abstract root of the VELYNX world model. Every typed entity — physical, organizational, geographic, or conceptual — inherits from here. Carries no attributes of its own; exists to anchor the top-level categories as siblings rather than unrelated trees.",
      "attributes": {}
    },

    "PhysicalObject": {
      "parent": "Entity",
      "facets": [],
      "disjoint_with": ["Concept"],
      "description": "Any entity that occupies space and has mass. A direct child of Entity; sibling to Organization, Location, and Concept.",
      "attributes": {
        "mass_kg": {
          "datatype": "float",
          "required": false,
          "default": null,
          "constraints": { "min": 0 },
          "description": "Rest mass in kilograms."
        },
        "location": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "Where the object currently is (free text or coordinate)."
        },
        "material": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "Dominant constituent material."
        }
      }
    },

    "Vehicle": {
      "parent": "PhysicalObject",
      "facets": [],
      "disjoint_with": ["Person", "Location"],
      "description": "A conveyance that moves people or cargo.",
      "attributes": {
        "mobility_type": {
          "datatype": "str",
          "required": true,
          "default": null,
          "constraints": {
            "enum": ["wheeled", "tracked", "winged", "waterborne", "railed", "legged"]
          },
          "description": "How the vehicle moves."
        },
        "max_speed_kph": {
          "datatype": "float",
          "required": false,
          "default": null,
          "constraints": { "min": 0, "max": 30000, "unit": "kph" },
          "description": "Rated top speed in kilometres per hour."
        },
        "passenger_capacity": {
          "datatype": "int",
          "required": false,
          "default": null,
          "constraints": { "min": 0, "max": 10000 },
          "description": "Designed occupant count."
        },
        "propulsion": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {
            "enum": ["combustion", "electric", "hybrid", "muscle", "sail", "jet", "rocket"]
          },
          "description": "Source of motive power."
        }
      }
    },

    "Electronics": {
      "parent": "PhysicalObject",
      "facets": [],
      "disjoint_with": ["Person", "Location"],
      "description": "An object whose primary function depends on controlled electric current.",
      "attributes": {
        "power_source": {
          "datatype": "str",
          "required": true,
          "default": null,
          "constraints": {
            "enum": ["battery", "mains", "solar", "kinetic", "external"]
          },
          "description": "How it draws electrical power."
        },
        "voltage": {
          "datatype": "float",
          "required": false,
          "default": null,
          "constraints": { "min": 0, "max": 100000, "unit": "V" },
          "description": "Operating voltage in volts."
        },
        "has_screen": {
          "datatype": "bool",
          "required": false,
          "default": false,
          "constraints": {},
          "description": "Whether it has a display surface."
        },
        "manufacturer": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "Original equipment manufacturer or brand."
        }
      }
    },

    "Person": {
      "parent": "PhysicalObject",
      "facets": [],
      "disjoint_with": ["Vehicle", "Electronics", "Organization"],
      "description": "A human being.",
      "attributes": {
        "age": {
          "datatype": "int",
          "required": false,
          "default": null,
          "constraints": { "min": 0, "max": 150 },
          "description": "Age in years."
        },
        "occupation": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "Primary vocation."
        },
        "date_of_birth": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "description": "ISO-8601 date of birth (YYYY-MM-DD)."
        },
        "employer": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "Name of the organisation the person works for."
        },
        "nationality": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "Country of citizenship or national affiliation."
        },
        "residence_location": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "City or region where the person lives."
        }
      }
    },

    "Organization": {
      "parent": "Entity",
      "facets": [],
      "disjoint_with": ["Person", "PhysicalObject", "Location"],
      "description": "A structured group of people with a collective purpose — a company, agency, institution, or association. Not a physical object; it is a legal or social construct.",
      "attributes": {
        "founded_year": {
          "datatype": "int",
          "required": false,
          "default": null,
          "constraints": { "min": 0, "max": 2100 },
          "description": "Calendar year the organisation was established."
        },
        "employee_count": {
          "datatype": "int",
          "required": false,
          "default": null,
          "constraints": { "min": 0 },
          "description": "Approximate number of people the organisation employs."
        },
        "industry": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {
            "enum": ["technology", "finance", "healthcare", "education", "manufacturing", "retail", "energy", "transportation", "media", "government", "nonprofit", "legal", "agriculture", "construction", "hospitality"]
          },
          "description": "Primary sector of economic or institutional activity."
        },
        "headquarters_location": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "City and country of the principal office."
        },
        "revenue_usd": {
          "datatype": "float",
          "required": false,
          "default": null,
          "constraints": { "min": 0 },
          "description": "Annual revenue in US dollars (approximate)."
        },
        "website": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "Primary public-facing web domain."
        },
        "legal_structure": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {
            "enum": ["corporation", "llc", "partnership", "sole_proprietorship", "nonprofit", "government_agency", "cooperative", "public_company", "private_company"]
          },
          "description": "Legal form under which the organisation operates."
        }
      }
    },

    "Company": {
      "parent": "Organization",
      "facets": [],
      "disjoint_with": [],
      "description": "A for-profit commercial organisation.",
      "attributes": {
        "ticker_symbol": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "Stock exchange ticker, if publicly traded."
        },
        "market_cap_usd": {
          "datatype": "float",
          "required": false,
          "default": null,
          "constraints": { "min": 0 },
          "description": "Market capitalisation in US dollars."
        }
      }
    },

    "GovernmentAgency": {
      "parent": "Organization",
      "facets": [],
      "disjoint_with": [],
      "description": "A department, bureau, or body operating under governmental authority.",
      "attributes": {
        "jurisdiction": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {
            "enum": ["federal", "state", "provincial", "municipal", "international", "tribal", "regional"]
          },
          "description": "Level of government the agency operates under."
        },
        "agency_type": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {
            "enum": ["executive", "legislative", "judicial", "regulatory", "military", "intelligence", "public_service", "research", "emergency_services"]
          },
          "description": "Functional category of the agency."
        }
      }
    },

    "EducationalInstitution": {
      "parent": "Organization",
      "facets": [],
      "disjoint_with": [],
      "description": "A school, college, university, or training body.",
      "attributes": {
        "accreditation": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "Accrediting body or standard."
        },
        "student_count": {
          "datatype": "int",
          "required": false,
          "default": null,
          "constraints": { "min": 0 },
          "description": "Enrolled student population."
        }
      }
    },

    "Location": {
      "parent": "Entity",
      "facets": [],
      "disjoint_with": ["Person", "Vehicle", "Electronics", "Organization", "Concept"],
      "description": "A place — geographic, built, or natural — defined by spatial coordinates and/or regional context.",
      "attributes": {
        "coordinates_lat": {
          "datatype": "float",
          "required": false,
          "default": null,
          "constraints": { "min": -90, "max": 90, "unit": "degrees" },
          "description": "Latitude in decimal degrees (WGS 84)."
        },
        "coordinates_lon": {
          "datatype": "float",
          "required": false,
          "default": null,
          "constraints": { "min": -180, "max": 180, "unit": "degrees" },
          "description": "Longitude in decimal degrees (WGS 84)."
        },
        "elevation_m": {
          "datatype": "float",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "Elevation above sea level in metres."
        },
        "country": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {},
          "description": "Sovereign state or territory containing the location."
        },
        "population": {
          "datatype": "int",
          "required": false,
          "default": null,
          "constraints": { "min": 0 },
          "description": "Resident or visiting population."
        },
        "area_sqkm": {
          "datatype": "float",
          "required": false,
          "default": null,
          "constraints": { "min": 0 },
          "description": "Surface area in square kilometres."
        },
        "climate_zone": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {
            "enum": ["tropical", "arid", "temperate", "continental", "polar", "mediterranean", "subtropical", "highland", "oceanic", "monsoon"]
          },
          "description": "Köppen-derived climate classification."
        }
      }
    },

    "Building": {
      "parent": "Location",
      "facets": [],
      "disjoint_with": [],
      "description": "A permanent structure with walls and a roof, occupying a specific geographic location. Instance-level PhysicalObject facet recommended for entities that also carry mass, material, or other physical attributes.",
      "attributes": {
        "floors": {
          "datatype": "int",
          "required": false,
          "default": null,
          "constraints": { "min": 1 },
          "description": "Number of above-ground storeys."
        },
        "building_type": {
          "datatype": "str",
          "required": false,
          "default": null,
          "constraints": {
            "enum": ["residential", "commercial", "industrial", "institutional", "mixed_use", "monument", "transportation", "religious", "educational", "government"]
          },
          "description": "Primary use classification."
        },
        "year_built": {
          "datatype": "int",
          "required": false,
          "default": null,
          "constraints": { "min": 0, "max": 2100 },
          "description": "Year construction was completed."
        }
      }
    },

    "City": {
      "parent": "Location",
      "facets": [],
      "disjoint_with": [],
      "description": "A large, permanently settled human settlement with defined administrative boundaries.",
